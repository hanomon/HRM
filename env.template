# ==========================================
# 환경 변수 템플릿
# ==========================================
# 
# 사용법:
# 1. Backend: 이 파일을 backend/.env로 복사
# 2. Frontend: frontend/.env.production 파일 생성
#
# ==========================================

# ==========================================
# Backend 환경 변수 (backend/.env)
# ==========================================

# 데이터베이스 연결 문자열
# 로컬 개발:
DATABASE_URL=postgres://hrm_user:your_password@localhost:5432/hrm_db

# Google Cloud SQL:
# DATABASE_URL=postgres://hrm_user:PASSWORD@CLOUD_SQL_IP:5432/hrm_db

# Node 환경
NODE_ENV=development  # 또는 production

# 서버 포트
PORT=3000  # 로컬 개발
# PORT=8080  # Cloud Run

# ==========================================
# Frontend 환경 변수 (frontend/.env.production)
# ==========================================

# API 엔드포인트
# 로컬:
# VITE_API_URL=http://localhost:3000/api

# Google Cloud Run:
# VITE_API_URL=https://hrm-backend-xxxxx-an.a.run.app/api

# ==========================================
# Google Cloud 설정
# ==========================================

# 프로젝트 ID
# GCP_PROJECT_ID=hrm-system-2024

# 리전
# GCP_REGION=asia-northeast3

# Cloud Storage 버킷
# GCS_BUCKET_NAME=hrm-frontend-2024

# ==========================================
# 보안 설정
# ==========================================

# CORS 허용 도메인
# CORS_ORIGINS=https://storage.googleapis.com,https://your-domain.com
